{
  "name": "seekrit-github-action",
  "version": "2.0.0",
  "private": true,
  "description": "Load secrets from seekrit into your GitHub Actions job environment.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/seekritdev/github-action.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
