        "input": {
          "HOST": "db.internal",
          "URL": "${HOST}/${MISSING}"
        },
        "expected": {
          "HOST": "db.internal",
          "URL": "db.internal/${MISSING}"
        },
        "unresolved": [
          "MISSING"
        ]
      },
      {
        "name": "$${NAME} escapes to a literal ${NAME}",
